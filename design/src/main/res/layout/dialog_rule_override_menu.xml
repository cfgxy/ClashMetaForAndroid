<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="master"
            type="com.github.kr328.clash.design.RuleOverridesDesign" />
        <variable
            name="self"
            type="android.app.Dialog" />
        <variable
            name="item"
            type="com.github.kr328.clash.service.model.RuleOverrideItem" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.github.kr328.clash.design.view.LargeActionLabel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> master.requestEdit(self, item)}"
            android:padding="@dimen/bottom_sheet_menu_items_padding"
            app:icon="@drawable/ic_baseline_edit"
            app:text="@string/edit" />

        <com.github.kr328.clash.design.view.LargeActionLabel
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> master.requestDelete(self, item)}"
            android:padding="@dimen/bottom_sheet_menu_items_padding"
            android:theme="@style/ThemeOverlay.ControlColorError"
            app:icon="@drawable/ic_outline_delete"
            app:text="@string/delete" />
    </LinearLayout>
</layout>
