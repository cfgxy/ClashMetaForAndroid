<?xml version="1.0" encoding="utf-8"?>
<!-- 线路名映射：包内每个线路名配一行，候选为内置策略 + 当前 profile 实际可用的策略组名。
     未完成映射时「继续」不可点——未映射的规则一条都不会写入，这里不允许含糊放行。 -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dialog_padding"
            android:paddingVertical="@dimen/dialog_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rule_bundle_mapping_title"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_text_margin"
                android:text="@string/rule_bundle_mapping_message"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

            <LinearLayout
                android:id="@+id/mapping_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_text_margin"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/incomplete_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_text_margin"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <Button
                android:id="@+id/confirm_view"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_padding"
                android:text="@string/rule_bundle_continue" />

            <Button
                android:id="@+id/cancel_view"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_button_margin"
                android:text="@string/cancel" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
