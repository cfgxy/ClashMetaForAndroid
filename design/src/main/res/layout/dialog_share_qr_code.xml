<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/dialog_padding">

        <ImageView
            android:id="@+id/qr_code_view"
            android:layout_width="@dimen/share_qr_code_size"
            android:layout_height="@dimen/share_qr_code_size"
            android:background="@android:color/white"
            android:contentDescription="@string/share_qr_code"
            android:padding="@dimen/share_qr_code_padding"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/profile_name_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_padding"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/large_item_text_margin"
            android:gravity="center_horizontal"
            android:text="@string/share_qr_code_tips"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
    </LinearLayout>
</layout>
